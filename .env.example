# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ASSET_CDN: Optional static asset CDN or object storage origin for domestic deployment.
# 本地开发留空即可，默认读取 /vistablog/manifest.json
# 上线示例: https://cdn.example.com/vistablog
VITE_ASSET_CDN=""

# VITE_MEDIA_MANIFEST_URL: 可选，直接指定 manifest 完整 URL（默认 ${VITE_ASSET_CDN}/manifest.json）
VITE_MEDIA_MANIFEST_URL=""

# VITE_IMAGE_PROXY: Optional image proxy endpoint for overseas image sources.
# Your proxy can receive the original URL as a `url` query parameter.
VITE_IMAGE_PROXY=""

# VITE_AUDIO_CDN: Optional CDN origin for background music or ambient audio files.
VITE_AUDIO_CDN=""

# VITE_CRAWLER_ENDPOINT: Optional backend endpoint for real crawler jobs.
# Keep crawler work on the server side so static deployments stay fast and compliant.
VITE_CRAWLER_ENDPOINT=""
